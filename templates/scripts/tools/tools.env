# Parameters for the tools in this folder. Set them once per project.
# Each line only sets a default: a variable already set in the environment wins.
# lib.sh loads this file for every tool. The plugin's Bash guard reads DEVICE_WRITE_OK from it.

: "${APP_DIR:=}"                   # absolute path of the Flutter app (the folder with pubspec.yaml); empty = two folders above this one
: "${FLUTTER:=flutter}"            # how to run Flutter: "flutter", or "fvm flutter" when the project pins its version with fvm
: "${DART:=}"                      # how to run Dart; empty = "fvm dart" when FLUTTER is "fvm flutter", else "dart"
: "${TEST_CONCURRENCY:=2}"         # q-test.sh and verify.sh run this many test files at once
: "${ANALYZE_MIN_FREE_MB:=1500}"   # q-analyze.sh waits for this much free memory (without the RAM plugin)
: "${TEST_MIN_FREE_MB:=2000}"      # q-test.sh and verify.sh wait for this much free memory (without the RAM plugin)
: "${BUILD_MIN_FREE_MB:=4000}"     # q-build.sh waits for this much free memory (without the RAM plugin)
: "${MEM_WAIT_ROUNDS:=40}"         # how many 15-second rounds a queued job waits for memory before it runs anyway
: "${DEVICE_WRITE_OK:=0}"          # 1 lets the Bash hook allow uninstalls, data wipes and settings changes on a phone: only the owner sets it
: "${RUNS_DIR:=}"                  # logs, reports and backups; empty = "$APP_DIR/runs"
: "${RAM_SH:=}"                    # the RAM plugin's ram.sh; empty = search for it; "off" = never use it
: "${HEAVY_LOCK:=}"                # the lock of the tools' own queue (without the RAM plugin); empty = a file named after the app
