<?xml version="1.0" encoding="utf-8"?>
<!-- Light mode, Android 5 to 11.
     Edge to edge (F9): both bars transparent or in the page colour, icons readable, no contrast scrim, and no
     windowOptOutEdgeToEdgeEnforcement (it stops working at target SDK 36). Dart sets the same style again at
     start (systemOverlayFor in lib/core/theme/system_bars.dart). -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/app_surface</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Honoured only before Android 15; from Android 15 the bar is always transparent. -->
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <!-- The app has its own dark theme; the system must not invert the light one. -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/app_surface</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Honoured only before Android 15; from Android 15 the bar is always transparent. -->
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <!-- The app has its own dark theme; the system must not invert the light one. -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>
