# Copy this file to assets/.env (git-ignored) and fill in the values.
# PUBLIC VALUES ONLY: everything in assets/.env ships inside the APK and the IPA as plain text, readable by anyone who
# has the app. Service keys, signing passwords and admin tokens live on the server or in CI, never here.
# `--dart-define=KEY=value` overrides one key for one build.

# The REST backend, HTTPS only.
API_BASE_URL=https://api.example.com
# Sent as X-App-Version on every call: the whole version of pubspec.yaml (x.y.z+build), the form q-build.sh passes
# with --dart-define.
APP_VERSION=1.0.0+1
